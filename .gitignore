# --- Secrets: never commit ---
.env
*.env
!.env.example

# --- Runtime data: SQLite DBs and logs are per-deployment, not source ---
data/
*.db
*.db-journal
*.log

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Local dev overrides (per-machine, not shared) ---
docker-compose.override.yml

# --- OS / editor cruft ---
.DS_Store
*.swp
.idea/
.vscode/
