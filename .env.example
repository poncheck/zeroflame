# Boost (stronghold.coffee) login — required for the sync scripts
# (boost_build_db.py / boost_incremental_update.py). Not needed just to
# browse an already-populated DB via the webapp.
BOOST_EMAIL=
BOOST_PASSWORD=

# Boost device/product code for your roaster (shown in Boost's own UI/API).
# Default below is cukru.coffee's; change it for other roasteries.
BOOST_PROD_CD=3528

# Directory where the 3 SQLite databases live. Inside Docker this should
# stay /app/data (matches the volume mount in docker-compose.yml) — only
# override it for bare-metal / non-Docker runs.
ZEROFLAME_DATA_DIR=/app/data

# Flask session signing key — generate a real random value for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-value

# Bootstrap admin account, used ONLY by scripts/init_db.py the first time
# it runs against an empty auth.db. Safe to remove from .env afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
